  "info": {
    "_postman_id": "3f933779-607a-478c-a009-c42498c1ca5f",
    "name": "Botanalytics Message Ingestion Messages API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Botanalytics REST ingestion API accepts conversational message events from chatbots and voice assistants for analytics processing. This specification is a faithful reconstruction of the single verified ingestion operation exposed by the Botanalytics v2 backend, derived from the first-party Node SDK source (github.com/botanalytics/node-sdk, core/src/base.js) and the public REST API documentation. It is NOT a provider-published OpenAPI document.\n\nContact Support:\n Name: Botanalytics",
      "type": "text/plain"
    }
  }
